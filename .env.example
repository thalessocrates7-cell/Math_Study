# Copy to .env.local for local development. Never commit real values.

# Signs the login cookies. Any long random string (32+ characters).
SESSION_SECRET=

# scrypt hash of the admin access code. Create it with:
#   npm run admin:hash -- "your access code"
ADMIN_CODE_HASH=

# Leave empty locally: the app then uses an embedded Postgres (PGlite) in .data/pglite.
# On Vercel, the Neon integration sets this to the pooled connection string.
DATABASE_URL=

# Optional: where the local PGlite database lives (default .data/pglite).
# PGLITE_DIR=.data/pglite
